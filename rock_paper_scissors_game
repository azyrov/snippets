let userChoice = +prompt(`Choose ONE of the following:
'1' for Rock
'2' for Paper
'3' for Scissors!`);

let min = 1;
let max = 3;
let random = Math.floor(Math.random() * (max - min + 1)) + min;

let message;

if (userChoice === random) {
    message = "Jinx! We chose the same thing! Try again."
}
else if (userChoice === 1) {
    if (random === 2) {
        message = "Paper covers Rock! Try again!"
    }
    else if (random === 3) {
        message = "Rock breaks Scissors. You WIN!."
    }
}
else if (userChoice === 2) {
    if (random === 1) {
        message = "Paper covers Rock. You WIN!"
    }
    else if (random === 3) {
        message = "Scissors cuts Paper. Try again."
    }
}
else if (userChoice === 3) {
    if (random === 1) {
        message = "Rock breaks Scissors. Try again."
    }
    else if (random === 2) {
        message = "Scissors cuts Paper. You WIN!"
    }
}
else {
    message = `Error. Choose only one of the following:
1
2 
3`
}


console.log(`${message}
My choice = ${random}`);
