cat << 'EOF' > app/api/send-sms/route.ts
import { NextResponse } from 'next/server'
import { supabase } from '@/lib/supabase'
import axios from 'axios'

export async function POST(request: Request) {
  try {
    const { phoneNumber } = await request.json()
    
    // 1. Generate the 6-digit code
    const otpCode = Math.floor(100000 + Math.random() * 900000).toString()

    // 2. The Hubtel Handshake (Matching your specific API URL format)
    await axios.get('https://smsc.hubtel.com/v1/messages/send', {
      params: {
        clientid: process.env.HUBTEL_CLIENT_ID,
        clientsecret: process.env.HUBTEL_CLIENT_SECRET,
        from: 'Fortunate',
        to: phoneNumber,
        content: `Your verification code is: ${otpCode}`
      }
    })

    // 3. Save to our Supabase Vault
    const { error: dbError } = await supabase
      .from('verifications')
      .insert([{ phone_number: phoneNumber, otp_code: otpCode }])

    if (dbError) throw dbError

    return NextResponse.json({ success: true })
  } catch (error: any) {
    // This will help us see if the error is from Hubtel or Supabase
    console.error('CRITICAL ERROR:', error.response?.data || error.message)
    return NextResponse.json({ success: false, error: 'Failed to send' }, { status: 500 })
  }
}
EOF

## create route file for verify-otp
import { NextResponse } from 'next/server'
import { supabase } from '@/lib/supabase'

export async function POST(request: Request) {
  try {
    const { phoneNumber, otpCode } = await request.json()

    // 1. Look in the 'verifications' table for a match
    const { data, error } = await supabase
      .from('verifications')
      .select('*')
      .eq('phone_number', phoneNumber)
      .eq('otp_code', otpCode)
      .order('created_at', { ascending: false })
      .limit(1)

    // 2. The Verification Check
    if (error || !data || data.length === 0) {
      return NextResponse.json({ success: false, error: 'Invalid or expired code' }, { status: 400 })
    }

    // 3. Success! The code matches.
    return NextResponse.json({ success: true, message: 'Verified successfully!' })

  } catch (error: any) {
    return NextResponse.json({ success: false, error: 'Internal Server Error' }, { status: 500 })
  }
}
