## create verification table at supabase
CREATE TABLE public.verifications (
  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  phone_number TEXT NOT NULL,
  otp_code TEXT NOT NULL,
  is_verified BOOLEAN DEFAULT false,
  created_at TIMESTAMPTZ DEFAULT now(),
  expires_at TIMESTAMPTZ DEFAULT (now() + interval '5 minutes')
);

## provide special RLS privileges for the website
-- 1. Turn on the Security Guard
ALTER TABLE public.verifications ENABLE ROW LEVEL SECURITY;
-- 2. Allow the website to "Insert" (add) new numbers
CREATE POLICY "Allow public insert" ON public.verifications 
FOR INSERT WITH CHECK (true);
-- 3. Allow the website to "Select" (find) codes to check them
CREATE POLICY "Allow public select" ON public.verifications 
FOR SELECT USING (true);

